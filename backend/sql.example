-- sql.example
-- Reference schema for the habits-tracker SQLite database.
-- This file is documentation only; the actual table is created
-- automatically by config/db.js on startup.

-- Database: habits-tracker.db

CREATE TABLE IF NOT EXISTS habit (
  id     TEXT PRIMARY KEY NOT NULL,          -- UUID generated by the API
  name   TEXT NOT NULL,                      -- habit name, e.g. "Drink water"
  time   TEXT NOT NULL,                      -- scheduled time, e.g. "08:00"
  color  TEXT NOT NULL DEFAULT 'gold',
  status TEXT NOT NULL DEFAULT 'pending'
);

CREATE TABLE IF NOT EXISTS habit_completion (
  habit_id       TEXT NOT NULL,
  completed_date TEXT NOT NULL,              -- YYYY-MM-DD
  completed_at   TEXT NOT NULL,              -- ISO 8601 timestamp
  PRIMARY KEY (habit_id, completed_date),
  FOREIGN KEY (habit_id) REFERENCES habit(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_habit_completion_date
  ON habit_completion(completed_date);